# Copy to .env (repo root, gitignored). Never commit real keys or tokens.
# The web app only reads web/.env.local (see web/.env.example); the Python engine reads this file.

# --- Web sign-in (also needed in web/.env.local) -------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Prefer setting these in web/.env.local (Next only reads that for the app)
NEXT_PUBLIC_SPACETIMEDB_URI=https://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIMEDB_DB=talon-prod

# --- SpacetimeDB for the engine (agents/, python -m talon_agents.live) ----------------------
# Where the live runner reads and writes. Local: http://127.0.0.1:4000 + talon-dev.
# Demo day: maincloud + talon-prod.
SPACETIMEDB_HOST=http://127.0.0.1:4000
SPACETIMEDB_DB_NAME=talon-dev
# Admin token for the engine's identity. Local: leave empty and run the runner once with
# --setup-admin (it saves a token to agents/.spacetime-tokens.json). talon-prod: ask an admin
# (Umair) to add your identity with add_admin, then put that identity's token here.
SPACETIMEDB_TOKEN=

# --- Nemotron models ------------------------------------------------------------------------
# With no key set, the engine runs on FakeLLM (offline, scripted). TALON_FAKE_LLM=1 forces it.
TALON_FAKE_LLM=

# Option A: our own vLLM server on Brev (docs/BREV.md). This is the key serve.sh was started
# with, not a Brev account token: on the instance it's in ~/.talon_key (cat ~/.talon_key).
# The Brev CLI itself uses `brev login` and needs nothing here.
#   Engine on the Brev instance:              NEMOTRON_BASE_URL=http://localhost:8000/v1
#   Engine on a laptop, with the tunnel open: brev port-forward talon-gpu --port 8000:8000
#                                              NEMOTRON_BASE_URL=http://localhost:8000/v1
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# Option B: NVIDIA's hosted API (build.nvidia.com). Only used when NEMOTRON_API_KEY is empty;
# keep the default NEMOTRON_BASE_URL above.
NVIDIA_API_KEY=

# Model served for every agent. serve.sh serves Nemotron Nano 9B v2 under this same ID, so it
# works with both options. Verify with: python -m talon_agents.check
NEMOTRON_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
# Optional per-agent overrides: TRIAGE_MODEL, EXTRACTOR_MODEL, HANDLER_MODEL, PERSONA_MODEL,
# SAFETY_MODEL, ANALYST_MODEL, SCAMMER_MODEL, JUDGE_MODEL, and {AGENT}_BASE_URL for a separate
# server, e.g. the safety guard model from `ENABLE_GUARD=1 bash agents/brev/serve.sh`:
# SAFETY_MODEL=nvidia/Llama-3.1-Nemotron-Safety-Guard-8B-v3
# SAFETY_BASE_URL=http://localhost:8001/v1

# Triage confidence needed before the customer sees a scam warning.
TRIAGE_THRESHOLD=0.7
