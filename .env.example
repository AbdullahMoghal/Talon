NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Prefer setting these in web/.env.local (Next only reads that for the app)
NEXT_PUBLIC_SPACETIMEDB_URI=https://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIMEDB_DB=talon-prod

# Talon agent engine (agents/). With no key set it runs on FakeLLM, offline.
# Brev (our own vLLM server, see docs/BREV.md): set NEMOTRON_API_KEY to the key the server was started with
# and NEMOTRON_BASE_URL to http://localhost:8000/v1 while `brev port-forward` is running.
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# build.nvidia.com key, only if not using Brev.
NVIDIA_API_KEY=
# Default model for every agent; verify IDs with GET /v1/models before relying on them.
NEMOTRON_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
# Optional per-agent overrides: TRIAGE_MODEL, EXTRACTOR_MODEL, HANDLER_MODEL, PERSONA_MODEL,
# SAFETY_MODEL, ANALYST_MODEL, SCAMMER_MODEL, JUDGE_MODEL. Per-agent endpoints work the same way, e.g.
# SAFETY_MODEL=nvidia/Llama-3.1-Nemotron-Safety-Guard-8B-v3 and SAFETY_BASE_URL=http://localhost:8001/v1
TRIAGE_THRESHOLD=0.7
